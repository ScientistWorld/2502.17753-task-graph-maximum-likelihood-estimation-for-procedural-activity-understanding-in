# Reuse the already-prepared base image instead of a scratch rootfs.
#
# The scratch container can build, but the scheduler's separate setup phase runs
# under fakeroot and needs a fuller runtime than the minimal vendored image
# provides. `base_container.sif` already exists in the workspace and is large
# enough to support the no-op setup stage reliably.
Bootstrap: localimage
From: /home/user/scratch/AgentWorkspaces/workspaces/2502.17753/environment/base_container.sif

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/home/user/.local/lib/python3.12/site-packages:/home/user
