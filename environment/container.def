# Apptainer definition file for the TGML paper environment.
#
# The cluster builder has failed on library, OCI, debootstrap, and localimage
# bootstraps, so this recipe uses a minimal scratch rootfs populated from the
# current host via %files.
#
Bootstrap: scratch

%files
    /usr/bin/bash /bin/bash
    /usr/bin/bash /bin/sh
    /usr/bin/env /usr/bin/env
    /usr/bin/python3 /usr/bin/python3
    /usr/bin/rm /usr/bin/rm
    /usr/bin/mkdir /usr/bin/mkdir
    /usr/local/bin/uv /usr/local/bin/uv
    /usr/lib/python3.12 /usr/lib/python3.12
    /usr/lib/python3/dist-packages /usr/lib/python3/dist-packages
    /usr/local/lib/python3.12/dist-packages /usr/local/lib/python3.12/dist-packages
    /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu
    /lib/x86_64-linux-gnu /lib/x86_64-linux-gnu
    /lib64/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2
    /etc/ssl/certs /etc/ssl/certs

%post
    mkdir -p /home/user
    mkdir -p /tmp
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PATH=/usr/local/bin:/usr/bin:/bin
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/home/user:$PYTHONPATH
