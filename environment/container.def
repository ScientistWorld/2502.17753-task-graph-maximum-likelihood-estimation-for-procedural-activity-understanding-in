Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        && rm -rf /var/lib/apt/lists/*


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install a clean CPU Python stack into the container overlay.
    # Compute jobs must not depend on the broken mounted /home/user/.local tree.
    set -e
    
    export UV_SYSTEM_PYTHON=1
    export UV_BREAK_SYSTEM_PACKAGES=1
    
    uv pip install --system \
      numpy==2.1.3 \
      networkx==3.4.2 \
      torch==2.5.1
    
    echo "setup.sh: installed clean system numpy/networkx/torch"

%environment
    export HOME=/home/user
    export PATH=/usr/local/bin:/usr/bin:/bin
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=/home/user/environment/pylibs:/home/user:/usr/local/lib/python3.12/site-packages:/usr/local/lib/python3.12/dist-packages
