# Docker-based container for TGML paper reproduction.
# Uses official Python 3.12 image with full OS support.
# Python packages come from the mounted workspace user site.

Bootstrap: docker
From: python:3.12-bookworm

%post
    # Install build essentials for any potential compilation
    apt-get update -qq && apt-get install -y -qq \
        python3-dev \
        build-essential \
        libopenblas-dev \
        liblapack-dev \
        libgomp1 \
        libgfortran5 \
    # Note: skip apt cache cleanup to avoid permission errors in shared tmp dirs

%environment
    export HOME=/home/user
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cu13/lib:/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.12/site-packages/nvidia/cusparselt/lib:/usr/local/lib/python3.12/site-packages/nvidia/nccl/lib:/usr/local/lib/python3.12/site-packages/nvidia/nvshmem/lib
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/home/user/.local/lib/python3.12/site-packages:/home/user
    export PYTHONDONTWRITEBYTECODE=1
