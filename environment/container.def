Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        && rm -rf /var/lib/apt/lists/*


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # No-op: all Python packages come from the mounted workspace site-packages.
    set -e
    echo "setup.sh: done (workspace packages)"

%environment
    export HOME=/home/user
    export PATH=/usr/local/bin:/usr/bin:/bin
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=/usr/local/lib/python3.12/dist-packages:/home/user/.local/lib/python3.12/site-packages:/home/user
