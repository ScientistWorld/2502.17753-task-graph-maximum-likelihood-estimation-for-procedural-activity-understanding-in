# Use a standard Python base image that can survive both the build step and the
# scheduler's separate fakeroot-wrapped setup phase.
#
# The paper run itself relies on packages already installed in the mounted
# workspace user site at /home/user/.local/lib/python3.12/site-packages, so the
# container only needs a normal Python 3.12 runtime plus bash/coreutils.
Bootstrap: docker
From: python:3.12

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/home/user/.local/lib/python3.12/site-packages:/home/user
