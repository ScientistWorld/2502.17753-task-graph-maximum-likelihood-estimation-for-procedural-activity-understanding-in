# Docker-based container for TGML paper reproduction.
# Uses official Python 3.12 image with full OS support.
# Installs torch (CPU) + deps in %post to avoid workspace dependency in setup.sh.

Bootstrap: docker
From: python:3.12-bookworm

%post
    # Bootstrap pip if not present
    python3 -m ensurepip --upgrade 2>/dev/null || true

    # Install torch CPU + dependencies
    # --extra-index-url gives CPU wheels; --index-url falls back to PyPI for other packages
    python3 -m pip install --no-cache-dir \
        torch \
        numpy \
        networkx \
        scikit-learn \
        scipy \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        || echo "pip install failed, will rely on workspace user site"

    # Install build essentials
    apt-get update -qq && apt-get install -y -qq \
        python3-dev \
        build-essential \
        libopenblas-dev \
        liblapack-dev \
        libgomp1 \
        libgfortran5 \
        || true

%environment
    export HOME=/home/user
    export PATH=/usr/local/bin:/usr/bin:/bin
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    # Prefer container-installed packages, fall back to workspace user site
    export PYTHONPATH=/usr/local/lib/python3.12/dist-packages:/usr/local/lib/python3.12/site-packages:/home/user/.local/lib/python3.12/site-packages:/home/user
