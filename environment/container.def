Bootstrap: docker
From: python:3.12-bookworm

%post
    set -e

    # Install uv for fast package management
    pip install --no-cache-dir uv

    # Install all required Python packages
    # Use CPU-only PyTorch for smaller image; the task is CPU-bound (small matrices)
    uv pip install --system --no-cache \
        "torch>=2.0.0" \
        "numpy>=1.24" \
        "networkx>=3.0" \
        "scikit-learn>=1.3"

%files
    /home/user/environment/runtime/.singularity.d/libs /.singularity.d/libs
    /home/user/environment/runtime/bin/bash /bin/bash
    /home/user/environment/runtime/bin/bash /bin/sh
    /home/user/environment/runtime/usr/bin /usr/bin
    /home/user/environment/runtime/usr/lib/python3.12 /usr/lib/python3.12
    /home/user/environment/runtime/usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu
    /home/user/environment/runtime/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu
    /home/user/environment/runtime/lib64 /lib64
    /home/user/environment/runtime/etc/python3.12 /etc/python3.12
    /home/user/environment/runtime/etc/ld.so.conf.d /etc/ld.so.conf.d

%environment
    export HOME=/home/user
    export PATH=/usr/bin:/bin
    export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/libfakeroot:/lib/x86_64-linux-gnu:/lib64
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/home/user/.local/lib/python3.12/site-packages:/home/user
