# Apptainer definition file for the TGML paper environment.
#
# The cluster builder has failed on library, OCI, debootstrap, and localimage
# bootstraps, so this recipe uses a minimal scratch rootfs populated from the
# current host via %files.
#
Bootstrap: scratch

%files
    /bin /bin
    /usr/bin /usr/bin
    /usr/lib /usr/lib
    /usr/local/lib /usr/local/lib
    /lib /lib
    /lib64 /lib64
    /etc/ssl/certs /etc/ssl/certs

%post
    mkdir -p /home/user
    mkdir -p /tmp
    chmod 755 /home/user


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install Python packages into the container overlay.
    #
    set -e
    
    # Install PyTorch with CUDA 12.1 support
    uv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
    
    # Install scientific computing packages
    uv pip install \
        numpy scipy scikit-learn networkx \
        matplotlib pandas
    
    # Install the paper's library from the cloned repo
    cd /home/user/method/repo/lib
    uv pip install -e .

%environment
    export HOME=/home/user
    export PATH=/usr/bin:/bin
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/home/user:$PYTHONPATH
