Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        && rm -rf /var/lib/apt/lists/*



    # --- Frozen environment (46 packages) ---
    # Sources: 3 both, 43 overlay-only, 0 setup-only
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    uv pip install --system \
        'autocommand==2.2.2' \
        'backports.tarfile==1.2.0' \
        'cuda_bindings==13.2.0' \
        'cuda_pathfinder==1.5.1' \
        'cuda_toolkit==13.0.2' \
        'filelock==3.25.2' \
        'fsspec==2026.3.0' \
        'importlib_metadata==8.7.1' \
        'jaraco.context==6.1.0' \
        'jaraco.functools==4.4.0' \
        'jaraco.text==4.0.0' \
        'jinja2==3.1.6' \
        'joblib==1.5.3' \
        'markupsafe==3.0.3' \
        'more_itertools==10.8.0' \
        'mpmath==1.3.0' \
        'networkx==3.4.2' \
        'numpy==2.4.4' \
        'nvidia_cublas==13.1.0.3' \
        'nvidia_cuda_cupti==13.0.85' \
        'nvidia_cuda_nvrtc==13.0.88' \
        'nvidia_cuda_runtime==13.0.96' \
        'nvidia_cudnn_cu13==9.19.0.56' \
        'nvidia_cufft==12.0.0.61' \
        'nvidia_cufile==1.15.1.6' \
        'nvidia_curand==10.4.0.35' \
        'nvidia_cusolver==12.0.4.66' \
        'nvidia_cusparse==12.6.3.3' \
        'nvidia_cusparselt_cu13==0.8.0' \
        'nvidia_nccl_cu13==2.28.9' \
        'nvidia_nvjitlink==13.0.88' \
        'nvidia_nvshmem_cu13==3.4.5' \
        'nvidia_nvtx==13.0.85' \
        'packaging==26.0' \
        'platformdirs==4.4.0' \
        'scikit_learn==1.8.0' \
        'scipy==1.17.1' \
        'setuptools==81.0.0' \
        'sympy==1.14.0' \
        'threadpoolctl==3.6.0' \
        'tomli==2.4.0' \
        'torch==2.11.0' \
        'triton==3.6.0' \
        'typing_extensions==4.15.0' \
        'wheel==0.46.3' \
        'zipp==3.23.0'

%environment
    export HOME=/home/user
    export PATH=/usr/local/bin:/usr/bin:/bin
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=/home/user/environment/pylibs:/home/user:/usr/local/lib/python3.12/site-packages:/usr/local/lib/python3.12/dist-packages
